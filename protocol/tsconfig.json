{
	"compilerOptions": {
		/*
		 * Pinned because TypeScript 6.0 changed this default.
		 *
		 * 6.0 turns noUncheckedSideEffectImports on and defaults `types` to [] rather than
		 * "every @types package it can find". Both are reasonable defaults and neither is
		 * something a version bump should decide: stating today's behaviour explicitly keeps
		 * the compiler upgrade a compiler upgrade. Turn them on deliberately, on their own.
		 */
		"noUncheckedSideEffectImports": false,
		/* TS 6.0 defaults `types` to []; this package relied on the implicit @types/node. */
		"types": ["node"],
		// Environment setup & latest features
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"jsx": "react-jsx",

		// Bundler mode
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,

		/* Enable importing .json files */
		"resolveJsonModule": true,

		/* Allow JavaScript files to be a part of your program. Use the `checkJS` option to get errors from these files. */
		"allowJs": true,
		/* Enable error reporting in type-checked JavaScript files. */
		"checkJs": false,

		/* Disable emitting files from a compilation. */
		"noEmit": true,

		/* Ensure that each file can be safely transpiled without relying on other imports. */
		"isolatedModules": true,
		/* Allow 'import x from y' when a module doesn't have a default export. */
		"allowSyntheticDefaultImports": true,
		/* Ensure that casing is correct in imports. */
		"forceConsistentCasingInFileNames": true,

		/* Enable all strict type-checking options. */
		"strict": true,

		/* Skip type checking all .d.ts files. */
		"skipLibCheck": true

		// Best practices
		// "noFallthroughCasesInSwitch": true,
		// "noUncheckedIndexedAccess": true,
		// "noImplicitOverride": true,
	}
}
