# Local settings for `bun run dev`, which loads worker/.env (gitignored) if it exists.
# Production uses judging.env instead; see judging.env.example for every variable.

# VEX Events (RobotEvents) API key, for event import and the Matches tab. The web app
# reaches VEX Events through this server, so this is the only place the key goes.
ROBOTEVENTS_TOKEN=
